{
  "name": "nk-fashion",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng lint && ng serve",
    "build": "ng lint && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "g:interceptor": "node ./scripts/generate-interceptor.js",
    "g:page": "node ./scripts/generate-page.js",
    "g:shared-component": "node ./scripts/generate-shared-component.js",
    "g:service": "node ./scripts/generate-service.js",
    "generate:api": "openapi-generator-cli generate -i rest_api.yml -g typescript-angular -o src/app/api --skip-validate-spec --additional-properties=modelOnly=true,api=false,service=false,module=false",
    "generate:models": "npm run generate:api && ts-node -P tsconfig.node.json generate_models.ts",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@angular/cdk": "^21.0.3",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.3",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "ngx-device-detector": "^11.0.0",
    "rxjs": "~7.8.0",
    "tailwindcss-animate": "^1.0.7",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.1.0",
    "@angular-eslint/eslint-plugin": "21.1.0",
    "@angular-eslint/eslint-plugin-template": "21.1.0",
    "@angular-eslint/schematics": "21.1.0",
    "@angular-eslint/template-parser": "21.1.0",
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.0",
    "@openapitools/openapi-generator-cli": "^2.23.0",
    "@types/jasmine": "~5.1.0",
    "@types/js-yaml": "^4.0.6",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "angular-eslint": "^20.2.0",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "jasmine-core": "~5.7.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^27.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "swagger-typescript-api": "^13.6.5",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
